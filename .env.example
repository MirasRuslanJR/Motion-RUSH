# Online features (global leaderboard + 1v1 duels). Optional: without them the game works offline.
# Supabase → Project Settings → API. Copy this file to .env.local for local development,
# and add the same variables in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
